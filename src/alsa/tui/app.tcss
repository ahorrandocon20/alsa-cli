Screen {
    background: $background;
}

/* --- búsqueda ------------------------------------------------------------- */

#search-scroll {
    scrollbar-size-vertical: 1;
    align-vertical: middle;
}

#title {
    width: auto;
    margin: 1 0 0 0;
}

#tagline {
    width: auto;
    color: $text-muted;
    margin: 1 0 0 0;
}

#scene {
    margin: 1 0 0 0;
    border-bottom: double $panel-lighten-2;
}

/* Alto de la terminal: tiny <22, compact 22-23, roomy 24-29, short 30-34 (120x30 de macOS), tall 35+. */
SearchScreen.-tiny #scene,
SearchScreen.-tiny #title,
SearchScreen.-compact #tagline,
SearchScreen.-compact #links,
SearchScreen.-roomy #tagline,
SearchScreen.-roomy #links,
SearchScreen.-short #tagline,
SearchScreen.-short #links,
SearchScreen.-tiny #tagline,
SearchScreen.-narrow #day-label {
    display: none;
}

SearchScreen.-compact #title {
    margin: 0;
}

SearchScreen.-compact #scene,
SearchScreen.-roomy #scene,
SearchScreen.-short #scene {
    height: 10;
    margin: 0;
    border-bottom: none;
}

SearchScreen.-compact #form {
    padding: 0 1;
}

SearchScreen.-compact .row,
SearchScreen.-roomy .row {
    margin-bottom: 0;
}

#stations-status.-empty {
    display: none;
}

#form {
    padding: 0 1;
}

SearchScreen.-compact .row,
SearchScreen.-roomy .row {
    margin-bottom: 0;
}

#stations-status.-empty {
    display: none;
}

#form {
    width: 84;
    max-width: 100%;
    height: auto;
    padding: 1 1 0 1;
}

.row {
    height: auto;
    margin-bottom: 1;
}

#form #submit-row {
    margin-bottom: 0;
}

.field-label {
    width: 11;
    color: $text-muted;
}

.inline-label {
    width: auto;
    margin-right: 1;
    color: $text-muted;
}

StationField {
    width: 1fr;
    height: auto;
}

StationField Input {
    width: 1fr;
    background: $surface;
    padding: 0 1;
}

StationField Input:focus {
    background: $panel;
}

StationField.-picked Input {
    color: $text;
    text-style: bold;
}

StationField.-invalid Input {
    background: $error 20%;
}

StationField Suggestions {
    display: none;
    overlay: screen;
    constrain: none inside;
    width: 1fr;
    height: auto;
    max-height: 10;
    background: $panel;
    border: none;
    padding: 0;
    scrollbar-size-vertical: 1;
}

StationField Suggestions.-open {
    display: block;
}

StationField Suggestions > .option-list--option {
    padding: 0 1;
}

StationField Suggestions > .option-list--option-highlighted {
    background: $primary;
    color: $text;
}

.swap-spacer {
    width: 6;
}

Center {
    height: auto;
}

#swap {
    width: 5;
    min-width: 5;
    margin-left: 1;
    background: transparent;
    color: $secondary;
    text-style: bold;
}

#swap:hover, #swap:focus {
    background: $panel;
}

.chip {
    width: auto;
    min-width: 10;
    margin-right: 2;
    padding: 0 2;
    background: $surface;
    color: $text;
    text-style: none;
}

.chip.-selected {
    background: $primary;
    text-style: bold;
}

.chip:focus {
    text-style: bold reverse;
}

.chip.-selected:focus {
    background: $secondary;
    color: $background;
    text-style: bold;
}

#day-label {
    width: 1fr;
    color: $secondary;
    padding-left: 1;
}

#time-row Select {
    width: 19;
    margin-right: 2;
}

SearchScreen.-narrow .field-label {
    width: 10;
}

SearchScreen.-narrow #time-row Select {
    margin-right: 1;
}

#time-row SelectCurrent {
    background: $surface;
}

#time-row Select:focus > SelectCurrent {
    background: $panel;
}

.stepper {
    width: 5;
    min-width: 5;
    background: $surface;
    text-style: bold;
}

.stepper:focus {
    background: $primary;
}

#pax-count {
    width: 14;
    content-align: center middle;
    text-style: bold;
}

#search {
    width: auto;
    padding: 0 3;
    text-style: bold;
}

#search:focus {
    background: $secondary;
    color: $background;
}

#form-error {
    width: 1fr;
    color: $error;
    padding-left: 2;
}

#links {
    height: auto;
    margin-top: 1;
}

#links-row {
    width: auto;
    height: auto;
}

.link {
    width: auto;
    min-width: 0;
    margin: 0 3;
    background: transparent;
    color: $secondary;
    text-style: none;
}

.link:hover, .link:focus {
    background: transparent;
    text-style: bold underline;
}

#stations-status {
    width: 100%;
    height: auto;
    content-align: center middle;
    text-align: center;
    margin-top: 1;
}

#stations-status.-error {
    color: $warning;
}

/* --- resultados ----------------------------------------------------------- */

#route-bar {
    height: 1;
    margin: 1 2 0 2;
}

#route {
    width: 1fr;
}

#route-day {
    width: auto;
    color: $secondary;
}

#summary {
    height: 1;
    margin: 0 2 1 2;
    color: $text-muted;
}

#results-body {
    height: 1fr;
}

#loading {
    align: center middle;
}

#loader {
    width: 100%;
    margin: 0 0 1 0;
}

#loading-text {
    width: 100%;
    text-align: center;
}

#message {
    align: center middle;
    padding: 0 4;
}

#message-text {
    width: auto;
    max-width: 80;
    text-align: center;
}

#list {
    height: 1fr;
}

#table {
    height: 1fr;
    margin: 0 1;
    background: transparent;
    scrollbar-size-vertical: 1;
}

#table > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: none;
}

#table > .datatable--cursor {
    background: $primary;
    color: $text;
}

#table > .datatable--even-row {
    background: $surface 40%;
}

#detail {
    height: auto;
    min-height: 6;
    background: $surface;
    padding: 1 2;
    margin: 1 1 0 1;
}

#detail-text {
    width: 1fr;
}

#detail-actions {
    width: 24;
    height: auto;
    align-horizontal: right;
}

#detail-actions Button {
    width: 100%;
    margin-bottom: 1;
}

#buy {
    text-style: bold;
}

ResultsScreen.-narrow #detail-actions {
    display: none;
}

/* --- diálogos ------------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $background 70%;
}

.dialog {
    overflow-y: auto;
    width: auto;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: tall $primary;
    padding: 1 3;
}

#buy-box, #purchase-box, #credits-box {
    width: 72;
}

#help-box {
    width: 104;
}

#help-cols {
    height: auto;
    margin-bottom: 1;
}

.help-col {
    width: 1fr;
    height: auto;
}

HelpScreen.-narrow #help-box {
    width: 56;
}

HelpScreen.-narrow #help-cols {
    layout: vertical;
}

HelpScreen.-narrow .help-col {
    width: 100%;
    margin-bottom: 1;
}

HelpScreen.-narrow .help-col:last-child {
    margin-bottom: 0;
}

HelpScreen.-short #help-note {
    display: none;
}

HelpScreen.-short .dialog {
    padding: 0 3;
}

HelpScreen.-short .dialog-title,
HelpScreen.-short #help-cols {
    margin-bottom: 0;
}

.dialog-title {
    text-style: bold;
    color: $secondary;
    margin-bottom: 1;
}

.dialog-text {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.dialog-hint {
    width: 30;
    color: $text-muted;
    margin: 1 0;
}

#buy-summary {
    background: $panel;
    padding: 1 2;
    margin-bottom: 1;
}

.dialog-buttons {
    height: auto;
    width: auto;
}

.dialog-buttons Button {
    width: auto;
    margin-right: 2;
}

.dialog-buttons Button.-primary {
    padding: 0 2;
    text-style: bold;
}

.dialog-buttons Button.-primary:focus {
    background: $secondary;
    color: $background;
}

Footer {
    background: $surface;
}

/* --- compra --------------------------------------------------------------- */

#buy-box {
    width: 80;
}

.dialog-subtitle {
    color: $text-muted;
    margin-bottom: 0;
}

#packages {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
    background: $panel;
    border: none;
    padding: 0;
}

#packages > .option-list--option {
    padding: 0 1;
}

#packages > .option-list--option-highlighted {
    background: $primary;
}

#packages:focus > .option-list--option-highlighted {
    background: $primary;
    text-style: none;
}

#checkout-box {
    width: 64;
}

#checkout-scene {
    margin-bottom: 1;
}

#checkout-box > .dialog-text:last-child {
    margin-bottom: 0;
}

CheckoutScreen.-short #checkout-scene {
    display: none;
}

BuyScreen.-short #buy-note {
    display: none;
}

BuyScreen.-short .dialog {
    padding: 0 2;
}

BuyScreen.-short #buy-summary {
    padding: 0 1;
}
